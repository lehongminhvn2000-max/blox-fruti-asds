-- Utility Event Handlers
local function addConnection(connection)
    table.insert(connections, connection)
    return connection
end

local function disconnectAll()
    for _, connection in ipairs(connections) do
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
    table.clear(connections)
    if noClipConnection then noClipConnection:Disconnect(); noClipConnection = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if spinConnection then spinConnection:Disconnect(); spinConnection = nil end
    if orbitConnection then orbitConnection:Disconnect(); orbitConnection = nil end
    if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
    if killauraConnection then killauraConnection:Disconnect(); killauraConnection = nil end
    if coinFarmConnection then coinFarmConnection:Disconnect(); coinFarmConnection = nil end
    if autoWeaponConnection then autoWeaponConnection:Disconnect(); autoWeaponConnection = nil end
    if oxygenConnection then oxygenConnection:Disconnect(); oxygenConnection = nil end
    if shieldConnection then shieldConnection:Disconnect(); shieldConnection = nil end
    if trapConnection then trapConnection:Disconnect(); trapConnection = nil end
end

local function getParts(player)
    local character = player and player.Character
    if not character then return nil, nil, nil end
    return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(cframe)
    local character, _, root = getParts(localPlayer)
    if not character or not root then
        if status then status.Text = "Character system not ready." end
        return
    end
    character:PivotTo(cframe)
    if status then status.Text = "Teleported successfully." end
end

local function clearList(list)
