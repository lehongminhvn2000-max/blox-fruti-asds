        spinRPS = math.clamp(value, 1, 10000)
        spinInput.Text = tostring(spinRPS)
        spinConnection = RunService.RenderStepped:Connect(function(dt)
            local character, humanoid, root = getParts(localPlayer)
            if root and humanoid and not flyEnabled then
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(360 * spinRPS * dt), 0)
            end
