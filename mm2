-- ULTRA FAST COIN & CANDY FARM
local function setCoinFarm(enabled)
    coinFarmEnabled = enabled
    local farmButton = content:FindFirstChild("CoinFarmButton")
    if farmButton then
        farmButton.Text = enabled and "Auto Candy/Coin Farm: ON" or "Candy/Coin Auto-Farm: OFF"
        farmButton.BackgroundColor3 = enabled and Color3.fromRGB(35, 125, 83) or Color3.fromRGB(45, 70, 120)
    end
    if coinFarmConnection then coinFarmConnection:Disconnect(); coinFarmConnection = nil end
    if enabled then
        -- Chuyển sang quét đa mục tiêu đồng thời trong mỗi khung hình RenderStepped để đạt tốc độ tối đa
        coinFarmConnection = RunService.RenderStepped:Connect(function()
            local ownChar, _, ownRoot = getParts(localPlayer)
            if not ownRoot then return end
            
            -- Chống chết: Tự động vô hiệu hóa va chạm tạm thời khi farm để không dính bẫy hoặc địa hình
            for _, part in ipairs(ownChar:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end

            local itemsToCollect = {}
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local name = obj.Name:lower()
                    if name == "coincontainer" or name == "goldcoin" or name == "candycane" or name == "coin" or name:find("candy") or name:find("token") or obj:FindFirstChild("CoinVisual") then
                        table.insert(itemsToCollect, obj)
                    end
                end
            end

            -- Thu thập hàng loạt vật phẩm gần nhất siêu tốc không có độ trễ delay
            if #itemsToCollect > 0 then
                table.sort(itemsToCollect, function(a, b)
                    return (ownRoot.Position - a.Position).Magnitude < (ownRoot.Position - b.Position).Magnitude
                end)
                
                -- Teleport tức thì đến mục tiêu đầu tiên tối ưu nhất
                ownRoot.CFrame = itemsToCollect[1].CFrame
                if firetouchinterest and itemsToCollect[1]:FindFirstChildOfClass("TouchInterest") then
                    firetouchinterest(ownRoot, itemsToCollect[1], 0)
                    firetouchinterest(ownRoot, itemsToCollect[1], 1)
                end
            end
        end)
    end
end

local function isPlayerInventoryItem(obj)
    for _, player in ipairs(Players:GetPlayers()) do
        local backpack = player:FindFirstChildOfClass("Backpack")
        if player.Character and obj:IsDescendantOf(player.Character) then return true end
        if backpack and obj:IsDescendantOf(backpack) then return true end
    end
    return false
end

local function getWorldPosition(obj)
    if obj:IsA("BasePart") then return obj.CFrame
    elseif obj:IsA("Model") then return obj:GetPivot()
    elseif obj:IsA("Tool") then
        local handle = obj:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle.CFrame end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.CFrame end
    end
    return nil
end

