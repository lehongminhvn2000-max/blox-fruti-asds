    button.Parent = list
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 4)
    addConnection(button.Activated:Connect(onClick))
    return button
end

local function refreshPlayers()
    clearList(playerList)
    table.clear(playerRowButtons)
    selectedPlayer = nil

    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)

    for _, player in ipairs(list) do
        if player ~= localPlayer then
            local button = addRow(playerList, player.DisplayName .. " (@" .. player.Name .. ")", function()
                selectedPlayer = player
                for p, row in pairs(playerRowButtons) do
                    row.BackgroundColor3 = (p == player) and Color3.fromRGB(48, 100, 170) or Color3.fromRGB(36, 40, 52)
                end
                status.Text = "Selected player: " .. player.Name
            end)
            playerRowButtons[player] = button
        end
    end
    status.Text = "Player list refreshed."
end

local function isPlayerInventoryItem(obj)
    for _, player in ipairs(Players:GetPlayers()) do
        local backpack = player:FindFirstChildOfClass("Backpack")
        if player.Character and obj:IsDescendantOf(player.Character) then
            return true
        end
        if backpack and obj:IsDescendantOf(backpack) then
            return true
        end
    end
    return false
end

local function getWorldPosition(obj)
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Model") then
        return obj:GetPivot()
    elseif obj:IsA("Tool") then
        local handle = obj:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then return handle.CFrame end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.CFrame end
    end
    return nil
end

local function refreshWeapons()
    clearList(weaponList)
    table.clear(weaponRowButtons)
    selectedWeapon = nil
    local found = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        local matches = name:find("gun") or name:find("revolver")
            or name:find("knife") or name:find("sheriff")
        if matches and (obj:IsA("Tool") or obj:IsA("Model")) and not isPlayerInventoryItem(obj) then
            if getWorldPosition(obj) then
                table.insert(found, obj)
            end
        end
    end

    for i, obj in ipairs(found) do
        local button = addRow(weaponList, obj.Name .. " #" .. i, function()
            selectedWeapon = obj
            for item, row in pairs(weaponRowButtons) do
                row.BackgroundColor3 = (item == obj) and Color3.fromRGB(48, 100, 170) or Color3.fromRGB(36, 40, 52)
            end
            status.Text = "Selected weapon: " .. obj.Name
        end)
        weaponRowButtons[obj] = button
    end
    status.Text = "Found " .. #found .. " possible dropped weapon(s)."
end

local function clearResults()
    clearList(results)
end

local function scanPlayerWeapons()
    clearResults()
    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)

    for _, player in ipairs(list) do
        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")
        local found = {}

        for _, container in ipairs({backpack, character}) do
            if container then
                for _, name in ipairs({"Knife", "Gun", "Revolver"}) do
                    local tool = container:FindFirstChild(name)
                    if tool and tool:IsA("Tool") and not table.find(found, name) then
                        table.insert(found, name)
                    end
                end
            end
        end

        local roleText = "UNKNOWN"
        local roleColor = Color3.fromRGB(230, 230, 235)

        if table.find(found, "Knife") then
            roleText = "MURDERER"
            roleColor = Color3.fromRGB(255, 75, 80)
        elseif table.find(found, "Gun") or table.find(found, "Revolver") then
            roleText = "SHERIFF"
            roleColor = Color3.fromRGB(75, 160, 255)
        end

        local text = player.Name .. "  |  " .. roleText
            .. (#found > 0 and ("  [" .. table.concat(found, ", ") .. "]") or "")
        local row = addRow(results, text, function()
            selectedPlayer = player
            status.Text = "Selected " .. player.Name .. " from scan."
        end)
        row.TextColor3 = roleColor
    end
    status.Text = "Scan complete. Tool-based role guesses are not guaranteed."
end

local function getToolHint(player)
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    for _, container in ipairs({backpack, character}) do
        if container then
            if container:FindFirstChild("Knife") then
                return Color3.fromRGB(255, 80, 85), "Possible Murderer"
            end
            if container:FindFirstChild("Gun") or container:FindFirstChild("Revolver") then
                return Color3.fromRGB(75, 160, 255), "Possible Sheriff"
            end
        end
    end
    return Color3.fromRGB(255, 220, 80), "No matching tool"
end

local function clearESP(player)
    local entry = espObjects[player]
    if not entry then return end
    if entry.highlight then entry.highlight:Destroy() end
    if entry.billboard then entry.billboard:Destroy() end
    espObjects[player] = nil
end

local function updateESP(player)
    if not espEnabled or player == localPlayer then
        clearESP(player)
        return
    end

    local character, humanoid, root = getParts(player)
    if not character or not humanoid or humanoid.Health <= 0 or not root then
        clearESP(player)
        return
    end

    local entry = espObjects[player]
    if not entry then
        local highlight = Instance.new("Highlight")
        highlight.Name = "MMHubESP"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.82
        highlight.OutlineTransparency = 0
        highlight.Adornee = character
        highlight.Parent = gui

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "MMHubESPLabel"
        billboard.Size = UDim2.fromOffset(220, 42)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = root
        billboard.Parent = gui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextStrokeTransparency = 0.2
        label.TextSize = 12
        label.Font = Enum.Font.GothamBold
        label.TextWrapped = true
        label.Parent = billboard

        entry = {highlight = highlight, billboard = billboard, label = label}
        espObjects[player] = entry
    else
        entry.highlight.Adornee = character
        entry.billboard.Adornee = root
    end

    local color, hint = getToolHint(player)
    entry.highlight.FillColor = color
    entry.highlight.OutlineColor = color
    entry.billboard.Enabled = espNamesEnabled
    entry.label.TextColor3 = color
    entry.label.Text = player.DisplayName .. " (@" .. player.Name .. ")\n" .. hint
end

local function setESP(enabled)
    espEnabled = enabled
    espButton.Text = enabled and "Player ESP: ON" or "Player ESP: OFF"
    espButton.BackgroundColor3 = enabled and Color3.fromRGB(35, 125, 83) or Color3.fromRGB(49, 78, 130)
    if not enabled then
        for player in pairs(espObjects) do clearESP(player) end
    else
        for _, player in ipairs(Players:GetPlayers()) do updateESP(player) end
    end
end

local function setESPNames(enabled)
    espNamesEnabled = enabled
    namesButton.Text = enabled and "ESP Names: ON" or "ESP Names: OFF"
    for _, entry in pairs(espObjects) do
        if entry.billboard then entry.billboard.Enabled = enabled end
    end
end

local function setSpeed(enabled)
    speedEnabled = enabled
    speedButton.Text = enabled and "Speed: ON" or "Speed: OFF"
    speedButton.BackgroundColor3 = enabled and Color3.fromRGB(35, 125, 83) or Color3.fromRGB(49, 78, 130)
    local _, humanoid = getParts(localPlayer)
    if humanoid then humanoid.WalkSpeed = enabled and speedValue or 16 end
end

local function applySpeed()
    local value = tonumber(speedInput.Text)
    if not value then
        status.Text = "Enter a speed from 16 to 100."
        return
    end
    speedValue = math.clamp(math.floor(value), 16, 100)
    speedInput.Text = tostring(speedValue)
    if speedEnabled then
        local _, humanoid = getParts(localPlayer)
        if humanoid then humanoid.WalkSpeed = speedValue end
    end
    status.Text = "Speed value set to " .. speedValue .. "."
end

local function restoreCollision()
    for part, original in pairs(originalCollision) do
        if part and part.Parent then part.CanCollide = original end
    end
    table.clear(originalCollision)
end

local function setNoClip(enabled)
    noClipEnabled = enabled
    noClipButton.Text = enabled and "No-clip: ON" or "No-clip: OFF"
    noClipButton.BackgroundColor3 = enabled and Color3.fromRGB(170, 105, 45) or Color3.fromRGB(49, 78, 130)

    if noClipConnection then
        noClipConnection:Disconnect()
        noClipConnection = nil
    end

    if enabled then
        noClipConnection = RunService.Stepped:Connect(function()
            local character = localPlayer.Character
            if not character then return end
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if originalCollision[part] == nil then
                        originalCollision[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end)
    else
        restoreCollision()
    end
end

local minimized = false
local savedHeight = main.Size.Y.Offset

local function setMinimized(enabled)
    minimized = enabled
    main.Size = UDim2.fromOffset(main.Size.X.Offset, enabled and 42 or savedHeight)
    minimize.Text = enabled and "+" or "-"

    for _, child in ipairs(main:GetChildren()) do
        if child ~= top and child ~= outline then
            child.Visible = not enabled
        end
    end
end

local function shutdown()
    if not running then return end
    running = false
    if noClipEnabled then setNoClip(false) end
    if speedEnabled then setSpeed(false) end
    for player in pairs(espObjects) do clearESP(player) end
    disconnectAll()
    gui:Destroy()
    script:Destroy()
end

