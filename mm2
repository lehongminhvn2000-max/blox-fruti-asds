local function getParts(player)
    local character = player and player.Character
    if not character then return nil, nil, nil end
    return character, character:FindFirstChildOfClass("Humanoid"), character:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(cframe)
    local character, humanoid, root = getParts(localPlayer)
    if not character or not root then
        status.Text = "Your character isn't ready."
        return
    end
    character:PivotTo(cframe + Vector3.new(0, 3, 0))
    status.Text = "Teleport attempted; server may correct movement."
end

local function clearList(list)
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function addRow(list, text, onClick)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 25)
    button.BackgroundColor3 = Color3.fromRGB(36, 40, 52)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(235, 238, 247)
