local function teleportToRole(roleName)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local _, hint = getToolHint(player)
            if hint:find(roleName) then
                local _, _, root = getParts(player)
                if root then
                    teleportTo(root.CFrame + Vector3.new(0, 3, 0))
                    status.Text = "Teleported to " .. roleName .. " (" .. player.Name .. ")"
                    return
                end
            end
        end
    end
    status.Text = "Target " .. roleName .. " not found or active."
end

local function serverHop()
    status.Text = "Finding clean public server server queue..."
    local x = game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    for _, server in ipairs(x.data) do
        if server.playing < server.maxPlayers and server.id ~= game.JobId then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, localPlayer)
            break
        end
    end
end

local function rejoinServer()
    status.Text = "Rejoining active instance..."
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
end

