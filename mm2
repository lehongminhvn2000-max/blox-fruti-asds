local function setAimbot(enabled)
    aimbotEnabled = enabled
    aimbotButton.Text = enabled and "Aim Lock Active (Camera Snapped)" or "Lock Camera View (Aim Lock): OFF"
    aimbotButton.BackgroundColor3 = enabled and Color3.fromRGB(35, 125, 83) or Color3.fromRGB(150, 45, 45)
    if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
    if enabled then
        aimbotConnection = RunService.RenderStepped:Connect(function()
            if not aimbotEnabled or not selectedPlayer or not selectedPlayer.Parent then return end
            local _, _, targetRoot = getParts(selectedPlayer)
            if targetRoot then
                local camera = Workspace.CurrentCamera
                if camera then
                    local char = selectedPlayer.Character
                    local targetPart = char and (char:FindFirstChild(aimbotBone) or targetRoot)
                    if targetPart then
                        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)
                    end
                end
            end
        end)
        status.Text = "Tracking vectors toward " .. aimbotBone .. " target bone."
    else
        status.Text = "Aimbot core standby."
    end
end

local function refreshWeapons()
    local weaponList = content:FindFirstChild("WeaponsList")
    if not weaponList then return end
    clearList(weaponList)
    table.clear(weaponRowButtons)
    selectedWeapon = nil
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        local matches = name:find("gun") or name:find("revolver") or name:find("knife") or name:find("sheriff")
        if matches and (obj:IsA("Tool") or obj:IsA("Model")) and not isPlayerInventoryItem(obj) then
            if getWorldPosition(obj) then table.insert(found, obj) end
        end
    end
    for i, obj in ipairs(found) do
        local button = addRow(weaponList, obj.Name .. " [" .. i .. "]", function()
            selectedWeapon = obj
            for item, row in pairs(weaponRowButtons) do
                row.BackgroundColor3 = (item == obj) and Color3.fromRGB(75, 135, 255) or Color3.fromRGB(30, 34, 46)
            end
            status.Text = "Selected dropped gear target: " .. obj.Name
        end)
        weaponRowButtons[obj] = button
    end
    status.Text = "Identified " .. #found .. " items resting across map bounds."
end

local function scanPlayerWeapons()
    clearList(results)
    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
    for _, player in ipairs(list) do
        local character = player.Character
        local backpack = player:FindFirstChildOfClass("Backpack")
        local found = {}
        for _, container in ipairs({backpack, character}) do
            if container then
                for _, name in ipairs({"Knife", "Gun", "Revolver"}) do
                    local tool = container:FindFirstChild(name)
                    if tool and tool:IsA("Tool") and not table.find(found, name) then
                        table.insert(found, name)
                    end
                end
            end
        end
        local roleText = "UNKNOWN INNOCENT"
        local roleColor = Color3.fromRGB(220, 225, 235)
        if table.find(found, "Knife") then
            roleText = "🚨 MURDERER"
            roleColor = Color3.fromRGB(255, 65, 70)
        elseif table.find(found, "Gun") or table.find(found, "Revolver") then
            roleText = "⭐ SHERIFF"
            roleColor = Color3.fromRGB(65, 145, 255)
        end
        local text = player.Name .. "  |  " .. roleText .. (#found > 0 and ("  [" .. table.concat(found, ", ") .. "]") or "")
        local row = addRow(results, text, function()
            selectedPlayer = player
            status.Text = "Diagnostic telemetry stream hooked on: " .. player.Name
        end)
        row.TextColor3 = roleColor
    end
    status.Text = "Comprehensive network grid audit complete."
end

