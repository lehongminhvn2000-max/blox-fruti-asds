-- Collision Management
local function restoreCollision()
    for part, original in pairs(originalCollision) do
        if part and part.Parent then part.CanCollide = original end
    end
    table.clear(originalCollision)
end

-- Telemetry Sweeper Core Logic
local function getToolHint(player)
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    for _, container in ipairs({backpack, character}) do
        if container then
            if container:FindFirstChild("Knife") then return Color3.fromRGB(255, 65, 70), "🚨 MURDERER" end
            if container:FindFirstChild("Gun") or container:FindFirstChild("Revolver") then return Color3.fromRGB(65, 145, 255), "⭐ SHERIFF" end
        end
    end
    return Color3.fromRGB(240, 240, 240), "Innocent"
end

local function clearESP(player)
    local entry = espObjects[player]
    if not entry then return end
    if entry.highlight then entry.highlight:Destroy() end
    if entry.billboard then entry.billboard:Destroy() end
    espObjects[player] = nil
end

local function updateESP(player)
    if not espEnabled or player == localPlayer then
        clearESP(player)
        return
    end
    local character, humanoid, root = getParts(player)
    if not character or not humanoid or humanoid.Health <= 0 or not root then
        clearESP(player)
        return
    end

    local entry = espObjects[player]
    if not entry then
        local highlight = Instance.new("Highlight")
        highlight.Name = "MMHubESP"
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.82
        highlight.OutlineTransparency = 0
        highlight.Adornee = character
        highlight.Parent = gui

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "MMHubESPLabel"
        billboard.Size = UDim2.fromOffset(220, 42)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = root
        billboard.Parent = gui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextStrokeTransparency = 0.1
        label.TextSize = 11
        label.Font = Enum.Font.GothamBold
        label.TextWrapped = true
        label.Parent = billboard

        entry = {highlight = highlight, billboard = billboard, label = label}
        espObjects[player] = entry
    else
        entry.highlight.Adornee = character
        entry.billboard.Adornee = root
    end

    local color, hint = getToolHint(player)
    entry.highlight.FillColor = color
    entry.highlight.OutlineColor = color
    entry.billboard.Enabled = espNamesEnabled
    entry.label.TextColor3 = color
    entry.label.Text = player.DisplayName .. " (@" .. player.Name .. ")\n" .. hint
end

-- Shutdown Sequence Block
local function shutdown()
    if not running then return end
    running = false
    
    if aimbotConnection then aimbotConnection:Disconnect(); aimbotConnection = nil end
    if noClipEnabled then restoreCollision() end
    if speedEnabled then speedEnabled = false end
    if flyEnabled then flyEnabled = false end
    if spinEnabled then spinEnabled = false end
    if orbitEnabled then orbitEnabled = false end
    if fullBrightEnabled then setFullBright(false) end
    
    for player in pairs(espObjects) do clearESP(player) end
    disconnectAll()
    
    if gui then gui:Destroy() end
    script:Destroy()
end

-- Global Stream Refresh Configurations
local function refreshPlayers()
    local playerList = content:FindFirstChild("PlayersList")
    if not playerList then return end
    clearList(playerList)
    table.clear(playerRowButtons)
    selectedPlayer = nil
    if spectateEnabled then
        spectateEnabled = false
        local spectateButton = content:FindFirstChild("SpectateButton")
        if spectateButton then spectateButton.Text = "Spectate Target: OFF" end
        local _, ownHum = getParts(localPlayer)
        if ownHum then Workspace.CurrentCamera.CameraSubject = ownHum end
    end
    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
    for _, player in ipairs(list) do
        if player ~= localPlayer then
            local button = addRow(playerList, player.DisplayName .. " (@" .. player.Name .. ")", function()
                selectedPlayer = player
                for p, row in pairs(playerRowButtons) do
                    row.BackgroundColor3 = (p == player) and Color3.fromRGB(75, 135, 255) or Color3.fromRGB(30, 34, 46)
                end
                status.Text = "Locked target on: " .. player.Name
                if spectateEnabled then
                    local _, targetHum = getParts(selectedPlayer)
                    if targetHum then Workspace.CurrentCamera.CameraSubject = targetHum end
                end
            end)
            playerRowButtons[player] = button
        end
    end
    status.Text = "Player list refreshed successfully."
end

