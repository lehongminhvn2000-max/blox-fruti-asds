end

local function setOrbit(enabled)
    orbitEnabled = enabled
    orbitButton.Text = enabled and "Orbit Sequence: ON" or "Orbit Target Sequence: OFF"
    orbitButton.BackgroundColor3 = enabled and Color3.fromRGB(35, 125, 83) or Color3.fromRGB(45, 70, 120)
