    if enabled then
        if not selectedPlayer then
            orbitEnabled = false
            orbitButton.Text = "Orbit Target Sequence: OFF"
            status.Text = "Specify a target destination asset first."
            return
        end
        orbitAngle = 0
        orbitConnection = RunService.RenderStepped:Connect(function(dt)
            if not selectedPlayer or selectedPlayer.Parent ~= Players then
                status.Text = "Aborting orbit tracking loop: Asset disconnected."
                setOrbit(false)
                return
            end
            local _, _, targetRoot = getParts(selectedPlayer)
            local character, humanoid, root = getParts(localPlayer)
            if not targetRoot or not root or not character or not humanoid or humanoid.Health <= 0 then return end
            orbitAngle += dt * 3
            local offset = Vector3.new(math.cos(orbitAngle) * orbitDistance, 2, math.sin(orbitAngle) * orbitDistance)
            character:PivotTo(CFrame.lookAt(targetRoot.Position + offset, targetRoot.Position))
        end)
        status.Text = "Linked trajectory rotation sequence on target."
    else
        status.Text = "Orbit connection severed safely."
    end
end

