-- Người chơi khác trước, rồi tới NPC (gộp theo tên, nên dummy hồi sinh vẫn giữ được tick)
local function getPickCandidates()
	local candidates = {}
	for _, other in Players:GetPlayers() do
		if other ~= player then
			table.insert(candidates, {
				key = "player:" .. other.UserId,
				name = if other.DisplayName ~= other.Name then `{other.DisplayName} (@{other.Name})` else other.Name,
				kind = "Player",
				team = if other.Team and not other.Neutral then other.Team.Name else nil,
			})
		end
	end
	local seenNames = {}
	for model in trackedModels do
		if model ~= player.Character and not Players:GetPlayerFromCharacter(model) and not seenNames[model.Name] then
			seenNames[model.Name] = true
			table.insert(candidates, { key = "npc:" .. model.Name, name = model.Name, kind = "NPC", team = getModelTeam(model) })
		end
	end
	table.sort(candidates, function(a, b)
		if a.kind ~= b.kind then
			return a.kind == "Player"
		end
		return string.lower(a.name) < string.lower(b.name)
	end)
	return candidates
end

local function refreshPicker()
	for _, child in pickerList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local candidates = getPickCandidates()
	pickedCount = 0
	for i, candidate in candidates do
		local selected = selectedTargets[candidate.key] == true
		if selected then
			pickedCount += 1
		end
		local row = create("TextButton", {
			Name = candidate.name,
			LayoutOrder = i,
			Size = UDim2.new(1, -6, 0, PICKER_ROW_HEIGHT),
			BackgroundColor3 = if selected then Color3.fromRGB(0, 60, 95) else COLORS.Window,
			AutoButtonColor = false,
			Text = "",
			Parent = pickerList,
		}, { corner(UDim.new(0, 4)) })
		local checkbox = create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 6, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = if selected then COLORS.Accent else COLORS.Off,
			Parent = row,
		}, { corner(UDim.new(0, 3)) })
		if selected then
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(6, 6),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Parent = checkbox,
			}, { corner(UDim.new(0, 2)) })
		end
		label({
			Position = UDim2.fromOffset(26, 0),
			Size = UDim2.new(1, -74, 1, 0),
			TextSize = 12,
			Text = candidate.name,
			TextColor3 = if candidate.team then getTeamColor(candidate.team) else COLORS.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 0),
			Size = UDim2.new(0, 40, 1, 0),
			TextSize = 10,
			TextColor3 = COLORS.SubText,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = candidate.kind,
			Parent = row,
		})
		row.MouseButton1Click:Connect(function()
			selectedTargets[candidate.key] = if selectedTargets[candidate.key] then nil else true
			refreshPicker()
		end)
	end
	if #candidates == 0 then
		label({
			Size = UDim2.new(1, 0, 0, PICKER_ROW_HEIGHT),
			TextSize = 12,
			TextColor3 = COLORS.SubText,
			Text = "  No other players or NPCs",
			Parent = pickerList,
		})
	end
	pickerList.Size = UDim2.new(1, 0, 0, math.clamp(#candidates, 1, PICKER_MAX_ROWS) * (PICKER_ROW_HEIGHT + 2))
	pickerCountLabel.Text = `{pickedCount} picked`
	pickerCountLabel.TextColor3 = if pickedCount > 0 then COLORS.Accent else COLORS.SubText
end

