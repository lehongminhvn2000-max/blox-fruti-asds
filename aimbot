--// Tabs

local pages, tabButtons = {}, {}

local function selectTab(name)
	for tabName, page in pages do
		local active = tabName == name
		page.Visible = active
		tabButtons[tabName].BackgroundColor3 = if active then COLORS.Accent else COLORS.Row
		tabButtons[tabName].TextColor3 = if active then Color3.new(1, 1, 1) else COLORS.SubText
	end
end

local function makePage(order, name)
	local button = create("TextButton", {
		Name = name .. "Tab",
		LayoutOrder = order,
		Size = UDim2.new(1 / 3, -4, 0, 24),
		BackgroundColor3 = COLORS.Row,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		Text = name,
		Parent = tabBar,
	}, { corner() })
	local page = create("Frame", {
		Name = name,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = pagesHolder,
	}, { listLayout(6) })
	button.MouseButton1Click:Connect(function()
		selectTab(name)
	end)
	pages[name], tabButtons[name] = page, button
	return page
end

