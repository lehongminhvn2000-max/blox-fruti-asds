local pages, tabButtons = {}, {}
local PAGE_MAX_HEIGHT = 430
local pageFits = {}

-- Trang cao tối đa sao cho đáy menu không lọt khỏi màn hình (tính cả Menu scale và vị trí menu)
local function getPageMaxHeight()
	local camera = workspace.CurrentCamera
	if not camera then
		return PAGE_MAX_HEIGHT
	end
	local scale = uiScale.Scale
	-- Phần khung cố định (header, tab, footer) + padding trên dưới của vùng trang
	local chrome = 20
	for _, child in window:GetChildren() do
		if child:IsA("GuiObject") and child.Visible and child ~= pagesHolder then
			chrome += child.AbsoluteSize.Y / scale
		end
	end
	local screenBottom = camera.ViewportSize.Y - GuiService:GetGuiInset().Y - 12
	local available = (screenBottom - window.AbsolutePosition.Y) / scale - chrome
	return math.clamp(available, 120, PAGE_MAX_HEIGHT)
end

local function refitPages()
	for _, fit in pageFits do
		fit()
	end
end
uiScale:GetPropertyChangedSignal("Scale"):Connect(refitPages)
window:GetPropertyChangedSignal("AbsolutePosition"):Connect(refitPages)
connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), refitPages)

local function selectTab(name)
	for tabName, page in pages do
		local active = tabName == name
		page.Visible = active
		tabButtons[tabName].BackgroundColor3 = if active then COLORS.Accent else COLORS.Row
		tabButtons[tabName].TextColor3 = if active then Color3.new(1, 1, 1) else COLORS.SubText
	end
