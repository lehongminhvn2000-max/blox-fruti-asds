--// Targeting

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

-- Bắn tia từ camera tới part; part tàng hình (Transparency ~1) không tính là vật chắn
local function isVisible(origin, part, model)
	local ignore = { model }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	for _ = 1, 8 do
		rayParams.FilterDescendantsInstances = ignore
		local result = workspace:Raycast(origin, part.Position - origin, rayParams)
		if not result then
			return true
		end
		if result.Instance.Transparency < 0.95 then
			return false
		end
		table.insert(ignore, result.Instance)
	end
	return false
end

local function getCharacterRoot()
	local character = player.Character
	return character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
end

-- Thứ tự part thử ngắm cho từng lựa chọn Target part; part đầu tiên còn nhìn thấy được sẽ được chọn
local PART_ORDER = {
	Head = { "Head" },
	["Head > Body"] = { "Head", "Torso", "Root" },
	Torso = { "Torso" },
	Root = { "Root" },
}

local function findPart(model, name)
	local part
	if name == "Torso" then
		part = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	elseif name == "Root" then
		part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	else
		part = model:FindFirstChild(name)
	end
	return if part and part:IsA("BasePart") then part else nil
end

-- Humanoid còn sống và không phải nhân vật mình
local function isAlive(model, humanoid)
	return humanoid.Health > 0
		and humanoid.Parent == model
		and model ~= player.Character
		and model:IsDescendantOf(workspace)
end

-- Player = model là nhân vật của một Player; Dummy = mọi model có Humanoid còn lại (NPC)
local function passesTypeFilter(model)
	if settings.TargetType == "Both" then
		return true
	end
	local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
	return if settings.TargetType == "Players only" then isPlayer else not isPlayer
end

local function isValidModel(model, humanoid)
	if not isAlive(model, humanoid) then
		return false
	end
	if settings.IgnoreForceField and model:FindFirstChildOfClass("ForceField") then
		return false
	end
	-- Pick players: chỉ xét danh sách đã tick, bỏ qua bộ lọc loại / team
	if settings.TargetMode == "Pick players" then
		return selectedTargets[getTargetKey(model)] == true
	end
	return passesTypeFilter(model) and passesTeamFilter(model)
end

-- 360°: bật toggle "360° (ignore FOV)" hoặc kéo FOV radius lên tối đa (1000)
local function isFullFov()
	return settings.IgnoreFOV or settings.FOV >= 1000
end

-- Trả về part để ngắm + độ lệch so với tâm FOV + khoảng cách thật (studs), nil nếu không ngắm được.
-- Độ lệch: pixel tới tâm FOV; chế độ 360° thì là góc (độ) giữa hướng camera và part.
-- "Head > Body": thử Head trước, Head bị che thì thử thân. "Closest": part gần tâm FOV nhất còn thấy được.
-- Wall check tắt mà mọi part đều bị che thì vẫn ngắm part đầu tiên (xuyên tường).
local function evaluate(camera, model, humanoid, fovCenter, originPos, maxCursorDistance)
	if not isValidModel(model, humanoid) then
		return nil
	end
	local candidates = {}
	if settings.TargetPart == "Closest" then
		-- Mọi bộ phận cơ thể nhìn thấy được (HumanoidRootPart tàng hình nên bị bỏ)
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") and child.Transparency < 1 then
				table.insert(candidates, child)
			end
		end
	else
		for _, name in PART_ORDER[settings.TargetPart] or PART_ORDER.Head do
			local part = findPart(model, name)
			if part then
				table.insert(candidates, part)
			end
		end
	end

	local cameraCFrame = camera.CFrame
	local scored = {}
	for _, part in candidates do
		local distance = (part.Position - originPos).Magnitude
		if distance > settings.MaxDistance then
			continue
		end
		local offset
		if isFullFov() then
			local direction = (part.Position - cameraCFrame.Position).Unit
			offset = math.deg(math.acos(math.clamp(cameraCFrame.LookVector:Dot(direction), -1, 1)))
		else
			local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
			if not onScreen then
				continue
			end
			offset = (Vector2.new(screenPos.X, screenPos.Y) - fovCenter).Magnitude
			if offset > maxCursorDistance then
				continue
			end
		end
		table.insert(scored, { part = part, offset = offset, distance = distance })
	end
	if settings.TargetPart == "Closest" then
		table.sort(scored, function(a, b)
			return a.offset < b.offset
		end)
	end

	local needsRaycast = settings.WallCheck or settings.TargetPart == "Head > Body"
	for _, entry in scored do
		if not needsRaycast or isVisible(cameraCFrame.Position, entry.part, model) then
			return entry.part, entry.offset, entry.distance
		end
	end
	local first = scored[1]
	if first and not settings.WallCheck then
		return first.part, first.offset, first.distance
	end
	return nil
end

-- excludeModel: bỏ qua model này (dùng khi bấm Switch target để nhảy sang mục tiêu khác)
local function findTarget(camera, mousePos, originPos, excludeModel)
	local bestModel, bestPart, bestScore = nil, nil, math.huge
	for model, humanoid in trackedModels do
		if model == excludeModel then
			continue
		end
		local part, cursorDistance, distance = evaluate(camera, model, humanoid, mousePos, originPos, settings.FOV)
		if not part then
			continue
		end
		local score = if settings.Priority == "Distance"
			then distance
			elseif settings.Priority == "Lowest HP" then humanoid.Health
			else cursorDistance
		if score < bestScore then
			bestModel, bestPart, bestScore = model, part, score
		end
	end
	return bestModel, bestPart
end

-- Đang khóa thì bỏ qua FOV; part có thể đổi qua lại Head/thân khi đầu bị che hoặc lộ ra
local function keepLock(camera, model, mousePos, originPos)
	local humanoid = trackedModels[model]
	if not humanoid then
		return nil
	end
	return (evaluate(camera, model, humanoid, mousePos, originPos, math.huge))
end

--// ESP: tên + thanh máu trên đầu mọi model còn sống (màu theo team, không phụ thuộc bộ lọc Team)

local espTags = {} -- [Model] = { billboard, nameLabel, healthFill }

local function getEspTag(model)
	local tag = espTags[model]
	if tag then
		return tag
	end
	local billboard = create("BillboardGui", {
		Name = "AimLockESP",
		Size = UDim2.fromOffset(160, 30),
		StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0),
		AlwaysOnTop = true,
		ResetOnSpawn = false,
		Parent = playerGui,
	})
	local nameLabel = label({
		Size = UDim2.new(1, 0, 0, 16),
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Parent = billboard,
	})
	local healthBar = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 20),
		Size = UDim2.new(0.5, 0, 0, 4),
		BackgroundColor3 = Color3.fromRGB(30, 30, 30),
		Parent = billboard,
	}, { corner(UDim.new(1, 0)) })
	local healthFill = create("Frame", { Size = UDim2.fromScale(1, 1), Parent = healthBar }, { corner(UDim.new(1, 0)) })
	tag = { billboard = billboard, nameLabel = nameLabel, healthFill = healthFill }
	espTags[model] = tag
	return tag
end

local function updateEsp(originPos)
	for model, tag in espTags do
		if not trackedModels[model] then
			tag.billboard:Destroy()
			espTags[model] = nil
		end
	end
	for model, humanoid in trackedModels do
		local adornee = model:FindFirstChild("Head") or model.PrimaryPart
		local show = settings.ESP
			and adornee ~= nil
			and adornee:IsA("BasePart")
			and isAlive(model, humanoid)
			and (adornee.Position - originPos).Magnitude <= settings.MaxDistance
		if not show then
			if espTags[model] then
				espTags[model].billboard.Enabled = false
			end
			continue
		end
		local tag = getEspTag(model)
		local team = getModelTeam(model)
		local health = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
		tag.billboard.Adornee = adornee
		tag.billboard.Enabled = true
		tag.nameLabel.Text = string.format("%s  [%d]", model.Name, math.floor((adornee.Position - originPos).Magnitude))
		tag.nameLabel.TextColor3 = if team then getTeamColor(team) else COLORS.Text
		tag.healthFill.Size = UDim2.fromScale(health, 1)
		tag.healthFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.HealthHigh, health)
	end
end

--// ESP box + tracer + snap line (vẽ 2D trên overlay)

local overlayTags = {} -- [Model] = { box, stroke, tracer }

local BOX_CORNERS = {}
for _, x in { -1, 1 } do
	for _, y in { -1, 1 } do
		for _, z in { -1, 1 } do
			table.insert(BOX_CORNERS, Vector3.new(x, y, z) / 2)
		end
	end
end

-- Khung 2D bao quanh model: chiếu 8 góc bounding box lên màn hình; nil nếu có góc nằm sau camera
local function getScreenBox(camera, model)
	local cframe, size = model:GetBoundingBox()
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, cornerOffset in BOX_CORNERS do
		local point = camera:WorldToViewportPoint(cframe:PointToWorldSpace(cornerOffset * size))
		if point.Z <= 0 then
			return nil
		end
		minX, minY = math.min(minX, point.X), math.min(minY, point.Y)
		maxX, maxY = math.max(maxX, point.X), math.max(maxY, point.Y)
	end
	return Vector2.new(minX, minY), Vector2.new(maxX, maxY)
end

local function getOverlayTag(model)
	local tag = overlayTags[model]
	if not tag then
		local box = create("Frame", { BackgroundTransparency = 1, Visible = false, Parent = overlay })
		tag = {
			box = box,
			stroke = create("UIStroke", { Thickness = 1.5, Parent = box }),
			tracer = makeLine(overlay),
		}
		overlayTags[model] = tag
	end
	return tag
end

local function updateOverlay(camera, originPos, fovCenter, targetModel, targetPart, stateColor)
	for model, tag in overlayTags do
		if not trackedModels[model] then
			tag.box:Destroy()
			tag.tracer:Destroy()
			overlayTags[model] = nil
		end
	end

	local viewport = camera.ViewportSize
	local tracerOrigin = Vector2.new(viewport.X / 2, viewport.Y)
	local wantOverlay = settings.ESPBoxes or settings.Tracers
	for model, humanoid in trackedModels do
		local anchor = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head")
		local topLeft, bottomRight = nil, nil
		if
			wantOverlay
			and anchor
			and isAlive(model, humanoid)
			and (anchor.Position - originPos).Magnitude <= settings.MaxDistance
		then
			topLeft, bottomRight = getScreenBox(camera, model)
		end
		local tag = overlayTags[model]
		if not topLeft then
			if tag then
				tag.box.Visible = false
				tag.tracer.Visible = false
			end
			continue
		end

		tag = getOverlayTag(model)
		local team = getModelTeam(model)
		local color = if model == targetModel then stateColor elseif team then getTeamColor(team) else COLORS.Text
		tag.box.Visible = settings.ESPBoxes
		tag.box.Position = UDim2.fromOffset(topLeft.X, topLeft.Y)
		tag.box.Size = UDim2.fromOffset(bottomRight.X - topLeft.X, bottomRight.Y - topLeft.Y)
		tag.stroke.Color = color
		if settings.Tracers then
			placeLine(tag.tracer, tracerOrigin, Vector2.new((topLeft.X + bottomRight.X) / 2, bottomRight.Y))
			tag.tracer.BackgroundColor3 = color
		else
			tag.tracer.Visible = false
		end
	end

	-- Snap line (từ tâm FOV tới part đang ngắm) + dấu đánh dấu ngay trên part đó
	local targetPoint = nil
	if targetPart and (settings.SnapLine or settings.TargetMarker) then
		local point, onScreen = camera:WorldToViewportPoint(targetPart.Position)
		targetPoint = if onScreen then Vector2.new(point.X, point.Y) else nil
	end
	if targetPoint and settings.SnapLine then
		placeLine(snapLine, fovCenter, targetPoint)
		snapLine.BackgroundColor3 = stateColor
	else
		snapLine.Visible = false
	end
	targetMarker.Visible = targetPoint ~= nil and settings.TargetMarker
	if targetMarker.Visible then
		targetMarker.Position = UDim2.fromOffset(targetPoint.X, targetPoint.Y)
		targetMarker.Rotation = (os.clock() * 90) % 360
		targetMarkerStroke.Color = stateColor
		targetMarkerDot.BackgroundColor3 = stateColor
	end
end

local function updateTargetInfo(targetModel, targetPart, originPos)
	local humanoid = targetModel and trackedModels[targetModel]
	if not (settings.TargetInfo and humanoid and targetPart) then
		infoCard.Visible = false
		return
	end
	local team = getModelTeam(targetModel)
	local health = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
	infoCard.Visible = true
	infoName.Text = targetModel.Name
	infoName.TextColor3 = if team then getTeamColor(team) else COLORS.Text
	infoDistance.Text = string.format("%d studs", math.floor((targetPart.Position - originPos).Magnitude))
	infoFill.Size = UDim2.fromScale(health, 1)
	infoFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.HealthHigh, health)
	infoDetail.Text = string.format(
		"%d / %d HP  ·  %s%s",
		math.ceil(humanoid.Health),
		math.floor(humanoid.MaxHealth),
		targetPart.Name,
		if team then "  ·  " .. team else ""
	)
end

--// Auto shoot: bóp cò Tool đang cầm (vd. súng Gun) khi tâm màn hình nằm trên mục tiêu đang khóa

local crosshairParams = RaycastParams.new()
crosshairParams.FilterType = Enum.RaycastFilterType.Exclude
crosshairParams.IgnoreWater = true

local function isCrosshairOn(camera, model)
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	crosshairParams.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(ray.Origin, ray.Direction * (settings.MaxDistance + 50), crosshairParams)
	return result ~= nil and result.Instance:IsDescendantOf(model)
end

local function getEquippedTool()
	local character = player.Character
	return character and character:FindFirstChildOfClass("Tool")
end

local autoFiringTool = nil
local lastAutoActivate = 0

-- 1 cú click = nhấn rồi nhả cò ngay (Tool:Activate/Deactivate làm Tool nhận Activated/Deactivated như bấm chuột)
local function clickTool(tool)
	pcall(tool.Activate, tool)
	pcall(tool.Deactivate, tool)
end

-- tool = Tool cần bắn, nil = thả cò.
--   Auto shoot 1 (Hold): giữ cò; súng bán tự động thì bóp lại theo FireRate của súng
--   Auto shoot 2 (Click): nhấn-nhả liên tục mỗi ClickDelay giây (như vòng lặp auto click)
local function setAutoFire(tool)
	local clickMode = settings.AutoShootMode == "2 - Click"
	if autoFiringTool ~= tool then
		if autoFiringTool then
			pcall(autoFiringTool.Deactivate, autoFiringTool)
		end
		autoFiringTool = tool
		if tool then
			if clickMode then
				clickTool(tool)
			else
				pcall(tool.Activate, tool)
			end
			lastAutoActivate = os.clock()
		end
		return
	end
	if not tool then
		return
	end
	local interval = if clickMode
		then settings.ClickDelay
		elseif tool:GetAttribute("Automatic") == false then tool:GetAttribute("FireRate") or 0.2
		else nil
	if interval and os.clock() - lastAutoActivate >= interval then
		lastAutoActivate = os.clock()
		if clickMode then
			clickTool(tool)
		else
			pcall(tool.Deactivate, tool)
			pcall(tool.Activate, tool)
		end
	end
end

--// Move: ép WalkSpeed / JumpPower khi bật; lưu giá trị gốc của từng Humanoid để trả lại khi tắt

local movementOriginals = {} -- [Humanoid] = { WalkSpeed, UseJumpPower, JumpPower, JumpHeight }

local function restoreMovement()
	for humanoid, original in movementOriginals do
		if humanoid.Parent then
			for property, value in original do
				humanoid[property] = value
			end
		end
		movementOriginals[humanoid] = nil
	end
end

local function applyMovement()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (settings.MoveEnabled and humanoid) then
		restoreMovement()
		return
	end
	if not movementOriginals[humanoid] then
		movementOriginals[humanoid] = {
			WalkSpeed = humanoid.WalkSpeed,
			UseJumpPower = humanoid.UseJumpPower,
			JumpPower = humanoid.JumpPower,
			JumpHeight = humanoid.JumpHeight,
		}
	end
	humanoid.WalkSpeed = settings.WalkSpeed
	-- R15 mới dùng JumpHeight; bật UseJumpPower để thanh kéo Jump power có tác dụng với mọi loại nhân vật
	humanoid.UseJumpPower = true
	humanoid.JumpPower = settings.JumpPower
end

--// Fly: LinearVelocity đẩy nhân vật theo hướng camera, AlignOrientation giữ người thẳng và quay theo camera

local flyState = nil -- { humanoid, root, attachment, velocity, align }

local function stopFly()
	if not flyState then
		return
	end
	flyState.velocity:Destroy()
	flyState.align:Destroy()
	flyState.attachment:Destroy()
	if flyState.humanoid.Parent then
		flyState.humanoid.PlatformStand = false
		flyState.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	flyState = nil
end

local function startFly(humanoid, root)
	local attachment = create("Attachment", { Name = "AimLockFly", Parent = root })
	local velocity = create("LinearVelocity", {
		Attachment0 = attachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		MaxForce = math.huge,
		VectorVelocity = Vector3.zero,
		Parent = root,
	})
	local align = create("AlignOrientation", {
		Mode = Enum.OrientationAlignmentMode.OneAttachment,
		Attachment0 = attachment,
		MaxTorque = math.huge,
		Responsiveness = 40,
		CFrame = root.CFrame.Rotation,
		Parent = root,
	})
	-- PlatformStand tắt đi bộ / trọng lực của Humanoid để không giành lực với LinearVelocity
	humanoid.PlatformStand = true
	flyState = { humanoid = humanoid, root = root, attachment = attachment, velocity = velocity, align = align }
end

local function updateFly(camera)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local canFly = settings.Fly and humanoid ~= nil and root ~= nil and humanoid.Health > 0
	if flyState and (not canFly or flyState.root ~= root) then
		stopFly()
	end
	if not canFly then
		return
	end
	if not flyState then
		startFly(humanoid, root)
	end

	local look = camera.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = if flatLook.Magnitude > 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)
	local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)

	-- Bàn phím: W/S theo hướng nhìn (cả lên xuống), A/D sang ngang, Space lên, Ctrl xuống.
	-- Không bấm phím nào thì lấy MoveDirection (gamepad / joystick mobile).
	local forward, right, vertical = 0, 0, 0
	if not UserInputService:GetFocusedTextBox() then
		local function down(keyCode)
			return if UserInputService:IsKeyDown(keyCode) then 1 else 0
		end
		forward = down(Enum.KeyCode.W) - down(Enum.KeyCode.S)
		right = down(Enum.KeyCode.D) - down(Enum.KeyCode.A)
		vertical = down(Enum.KeyCode.Space) - down(Enum.KeyCode.LeftControl)
	end
	if forward == 0 and right == 0 then
		local moveDirection = humanoid.MoveDirection
		forward, right = moveDirection:Dot(flatLook), moveDirection:Dot(flatRight)
	end

	local direction = look * forward + flatRight * right + Vector3.yAxis * vertical
	if direction.Magnitude > 1 then
		direction = direction.Unit
	end
	flyState.velocity.VectorVelocity = direction * settings.FlySpeed
	flyState.align.CFrame = CFrame.lookAt(Vector3.zero, flatLook)
end

--// Always aim: bật thì ép các cài đặt dưới đây (không cần giữ chuột, 360°, chỉ ngắm ai đang lộ ra,
-- khóa xong bắn luôn); tắt thì trả lại đúng giá trị trước khi bật

local ALWAYS_AIM_OVERRIDES = {
	Enabled = true,
	AimKey = "Always",
	IgnoreFOV = true,
	WallCheck = true,
	AutoShoot = true,
	StickyLock = true,
	Smoothness = 0,
}

local function updateAlwaysAim()
	if settings.AlwaysAim and not alwaysAimSnapshot then
		alwaysAimSnapshot = {}
		for key, value in ALWAYS_AIM_OVERRIDES do
			alwaysAimSnapshot[key] = settings[key]
			settings[key] = value
		end
		notify("Always aim: ON · auto lock + shoot", COLORS.Locked)
	elseif not settings.AlwaysAim and alwaysAimSnapshot then
		for key, value in alwaysAimSnapshot do
			settings[key] = value
		end
		alwaysAimSnapshot = nil
		notify("Always aim: OFF", COLORS.SubText)
	else
		return
	end
	for _, render in controlRenderers do
		render()
	end
end

--// Main loop: chạy ngay sau camera mặc định để ghi đè hướng nhìn

local lockedModel = nil

RunService:BindToRenderStep("AimLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if mouseFree then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	applyMovement()
	applyTheme()

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	updateFly(camera)
	local mousePos = UserInputService:GetMouseLocation()
	local fovCenter = if settings.FOVOrigin == "Center" then camera.ViewportSize / 2 else mousePos
	local root = getCharacterRoot()
	local originPos = if root then root.Position else camera.CFrame.Position

	updateAlwaysAim()
	local aimInput = AIM_KEYS[settings.AimKey]
	if not settings.Enabled or settings.AimActivation ~= "Toggle" then
		aimToggled = false
	end
	-- Chỉ aim bằng chuột trái mới bị chặn khi đang bấm/kéo menu
	local uiBusy = aimInput == Enum.UserInputType.MouseButton1
		and (activeSlider ~= nil or dragStart ~= nil or isPointerOverMenu(mousePos))
	local holding = settings.Enabled
		and (
			aimInput == nil
			or (
				if settings.AimActivation == "Toggle"
					then aimToggled
					else not uiBusy and UserInputService:IsMouseButtonPressed(aimInput)
			)
		)

	-- Switch target: đang khóa thì chuyển sang mục tiêu tốt nhất còn lại (cần bật Sticky lock để giữ)
	if switchRequested then
		switchRequested = false
		if holding and lockedModel then
			local nextModel = findTarget(camera, fovCenter, originPos, lockedModel)
			if nextModel then
				lockedModel = nextModel
				notify(`Switched to {nextModel.Name}`, COLORS.Accent)
			else
				notify("No other target", COLORS.SubText)
			end
		else
			notify("Not locked on a target", COLORS.SubText)
		end
	end

	-- Đang aim thì giữ mục tiêu cũ tới khi nó chết / bị che / ra khỏi màn hình, tránh nhảy mục tiêu
	local targetModel, targetPart = nil, nil
	if holding and lockedModel and settings.StickyLock then
		targetPart = keepLock(camera, lockedModel, fovCenter, originPos)
		targetModel = if targetPart then lockedModel else nil
	end
	if not targetPart and settings.Enabled then
		targetModel, targetPart = findTarget(camera, fovCenter, originPos)
	end
	local aiming = holding and targetPart ~= nil
	lockedModel = if aiming then targetModel else nil

	if aiming then
		local aimPos = targetPart.Position + targetPart.AssemblyLinearVelocity * settings.Prediction
		local alpha = if settings.Smoothness <= 0 then 1 else 1 - math.exp(-dt * 30 / settings.Smoothness)
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, aimPos), alpha)
	end

	local stateColor = if aiming then COLORS.Locked elseif targetPart then COLORS.Tracking else COLORS.Accent
	fovCircle.Visible = settings.Enabled and settings.ShowFOV and not isFullFov()
	fovCircle.Position = UDim2.fromOffset(fovCenter.X, fovCenter.Y)
	cursorDot.Visible = mouseFree
	cursorDot.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
	fovCircle.Size = UDim2.fromOffset(settings.FOV * 2, settings.FOV * 2)
	fovStroke.Color = stateColor
	statusDot.BackgroundColor3 = if settings.Enabled then stateColor else COLORS.Off

	local highlightModel = if targetModel and settings.Highlight then targetModel else nil
	if highlight.Adornee ~= highlightModel then
		highlight.Adornee = highlightModel
	end
	highlight.Enabled = highlightModel ~= nil
	highlight.FillColor = stateColor

	if targetModel then
		local team = getModelTeam(targetModel)
		statusLabel.Text = string.format(
			"Target: %s (%s)  ·  %d studs%s",
			targetModel.Name,
			targetPart.Name,
			math.floor((targetPart.Position - originPos).Magnitude),
			if team then "  ·  " .. team else ""
		)
	else
		statusLabel.Text = if not settings.Enabled
			then "Aim lock: OFF"
			elseif settings.TargetMode == "Pick players" then `Target: none  ·  {pickedCount} picked`
			else "Target: none"
	end

	updateEsp(originPos)
	updateOverlay(camera, originPos, fovCenter, targetModel, targetPart, stateColor)
	updateTargetInfo(targetModel, targetPart, originPos)
	setAutoFire(
		if settings.AutoShoot and aiming and isCrosshairOn(camera, targetModel) then getEquippedTool() else nil
	)
end)

--// X (hoặc nút X trên menu): tắt hẳn script, gỡ mọi kết nối và xóa toàn bộ UI

local unloaded = false

unload = function()
	if unloaded then
		return
	end
	unloaded = true
	stopSaving = true
	saveNow()
	setAutoFire(nil)
	restoreMovement()
	stopFly()
	RunService:UnbindFromRenderStep("AimLock")
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, tag in espTags do
		tag.billboard:Destroy()
	end
	table.clear(espTags)
	if mouseFree then
		setMouseFree(false)
	end
	gui:Destroy()
end

closeButton.MouseButton1Click:Connect(unload)
