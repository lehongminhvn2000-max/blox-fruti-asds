	local button = create("TextButton", {
		Name = name .. "Tab",
		LayoutOrder = order,
		Size = UDim2.new(1 / 5, -5, 0, 24),
		BackgroundColor3 = COLORS.Row,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		Text = name,
		Parent = tabBar,
	}, {
		corner(),
		-- 5 tab nên chữ tự co cho vừa, tối đa 12px
		create("UITextSizeConstraint", { MaxTextSize = 12 }),
		create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3) }),
	})
	-- Tab dài quá PAGE_MAX_HEIGHT thì cuộn được, menu không dài quá màn hình
	local layout = listLayout(6)
	local page = create("ScrollingFrame", {
		Name = name,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = COLORS.SubText,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = pagesHolder,
	}, { layout })
	local function fit()
		-- AbsoluteContentSize đã nhân UIScale nên chia lại để ra kích thước gốc
		page.Size = UDim2.new(1, 0, 0, math.min(layout.AbsoluteContentSize.Y / uiScale.Scale, getPageMaxHeight()))
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
	table.insert(pageFits, fit)
	fit()
	button.MouseButton1Click:Connect(function()
		selectTab(name)
	end)
	pages[name], tabButtons[name] = page, button
	return page
end

