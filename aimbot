local function matchesKey(action, keyCode)
	-- Alt trái/phải đều dùng được khi phím thả chuột còn để mặc định
	if action == "FreeMouse" and keybinds.FreeMouse == Enum.KeyCode.LeftAlt and keyCode == Enum.KeyCode.RightAlt then
		return true
	end
	return keyCode == keybinds[action]
end

