local function placeLine(line, from, to)
	local delta = to - from
	line.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
	line.Size = UDim2.fromOffset(delta.Magnitude, 1.5)
	line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	line.Visible = true
end

