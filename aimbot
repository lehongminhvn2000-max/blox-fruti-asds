local DEFAULT_WINDOW_POSITION = window.Position
local saveRemotes = nil
local saveEnabled = false
local stopSaving = false
local lastSavedJson = nil

local function serializeState()
	local keys = {}
	for action, keyCode in keybinds do
		keys[action] = keyCode.Name
	end
	local picked = {}
	for key in selectedTargets do
		table.insert(picked, key)
	end
	table.sort(picked)
	local position = window.Position
	-- Đang bật Always aim thì lưu giá trị gốc (trước khi bị ép), không lưu chính Always aim
	local savedSettings = table.clone(settings)
	for key, value in alwaysAimSnapshot or {} do
		savedSettings[key] = value
	end
	savedSettings.AlwaysAim = false
	return {
		settings = savedSettings,
		keybinds = keys,
		picked = picked,
		window = { position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset },
	}
end

-- Chỉ nhận key có trong mặc định và đúng kiểu, nên dữ liệu cũ / hỏng không làm lỗi script
local function applyState(data)
	if type(data) ~= "table" then
		return
	end
	if type(data.settings) == "table" then
		for key, value in data.settings do
			if key ~= "Fly" and DEFAULT_SETTINGS[key] ~= nil and type(value) == type(DEFAULT_SETTINGS[key]) then
				settings[key] = value
			end
		end
	end
	if type(data.keybinds) == "table" then
		for action, name in data.keybinds do
			local ok, keyCode = pcall(function()
				return Enum.KeyCode[name]
			end)
			if DEFAULT_KEYBINDS[action] and ok and keyCode then
				keybinds[action] = keyCode
			end
		end
	end
	if type(data.picked) == "table" then
		table.clear(selectedTargets)
		for _, key in data.picked do
			if type(key) == "string" then
				selectedTargets[key] = true
			end
		end
	end
	if type(data.window) == "table" and #data.window == 4 then
		local ok, position = pcall(UDim2.new, table.unpack(data.window))
		if ok then
			window.Position = position
		end
	end
	for _, render in controlRenderers do
		render()
	end
	for action in keybindButtons do
		renderKeybind(action)
	end
	renderTitle()
	renderHint()
	-- Màn hình nhỏ hơn lần trước: đưa menu về chỗ mặc định nếu bị lọt ra ngoài
	task.defer(function()
		local viewport = workspace.CurrentCamera.ViewportSize
		local topLeft = window.AbsolutePosition
		if topLeft.X < -100 or topLeft.Y < -100 or topLeft.X > viewport.X - 60 or topLeft.Y > viewport.Y - 60 then
			window.Position = DEFAULT_WINDOW_POSITION
		end
	end)
end

local function saveNow()
	if not saveEnabled or not saveRemotes then
		return
	end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, serializeState())
	if ok and json ~= lastSavedJson then
		lastSavedJson = json
		saveRemotes.Save:FireServer(json)
	end
end

task.spawn(function()
	saveRemotes = ReplicatedStorage:WaitForChild("AimLock", 10)
	if not saveRemotes then
		saveStatusLabel.Text = " Settings: not saved (no server script)"
		return
	end
	local ok, success, payload = pcall(saveRemotes.Load.InvokeServer, saveRemotes.Load)
	if stopSaving then
		return
	end
	if not ok or not success then
		saveStatusLabel.Text = " Settings: not saved (DataStore off)"
		saveStatusLabel.TextColor3 = COLORS.Tracking
		return
	end
	if payload then
		local decoded, data = pcall(HttpService.JSONDecode, HttpService, payload)
		if decoded then
			applyState(data)
			notify("Settings loaded", COLORS.Accent)
		end
	end
	lastSavedJson = HttpService:JSONEncode(serializeState())
	saveEnabled = true
	saveStatusLabel.Text = " Settings: auto-saved"
	while not stopSaving do
		task.wait(5)
		saveNow()
	end
end)

