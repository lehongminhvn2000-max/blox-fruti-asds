local activeSlider = nil

local function makeSlider(parent, order, text, key, min, max, step, format)
	local row = create("Frame", {
		Name = key,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = COLORS.Row,
		Parent = parent,
	}, { corner() })
	label({ Text = text, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(0.5, 0, 0, 18), Parent = row })
	local valueLabel = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 4),
		Size = UDim2.new(0.5, -10, 0, 18),
		Font = Enum.Font.GothamBold,
		TextColor3 = COLORS.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local bar = create("Frame", {
		Position = UDim2.new(0, 10, 0, 28),
		Size = UDim2.new(1, -20, 0, 6),
		BackgroundColor3 = COLORS.Off,
		Parent = row,
	}, { corner(UDim.new(1, 0)) })
	local fill = create("Frame", { BackgroundColor3 = COLORS.Accent, Parent = bar }, { corner(UDim.new(1, 0)) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = bar,
	}, { corner(UDim.new(1, 0)) })
	local hitbox = create("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = bar,
	})

	local function render()
		local alpha = (settings[key] - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		-- format có thể là chuỗi string.format hoặc hàm trả về chữ hiển thị
		valueLabel.Text = if type(format) == "function" then format(settings[key]) else string.format(format, settings[key])
	end

	local function setFromX(x)
		local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local value = min + (max - min) * alpha
		settings[key] = math.clamp(math.round(value / step) * step, min, max)
		render()
	end

	hitbox.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = setFromX
			setFromX(input.Position.X)
		end
	end)
	render()
	table.insert(controlRenderers, render)
end

-- Dropdown mở rộng ngay trong menu; getOptions được gọi mỗi lần mở nên danh sách team luôn mới
local function makeDropdown(parent, order, text, key, getOptions, getOptionColor, onChange)
	local container = create("Frame", {
		Name = key,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS.Row,
		Parent = parent,
	}, { corner(), listLayout() })

	local headerButton = create("TextButton", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = container,
	})
	label({ Text = text, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.45, 0, 1, 0), Parent = headerButton })
	local valueLabel = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -26, 0, 0),
		Size = UDim2.new(0.55, -26, 1, 0),
		Font = Enum.Font.GothamBold,
		TextColor3 = COLORS.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = headerButton,
	})
	local arrow = label({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = COLORS.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = ">",
		Parent = headerButton,
	})

	local list = create("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = container,
	}, {
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
		}),
		listLayout(2),
	})

	local function render()
		valueLabel.Text = tostring(settings[key])
		arrow.Rotation = if list.Visible then -90 else 90
	end

	local function close()
		list.Visible = false
		render()
	end

	local function open()
		for _, child in list:GetChildren() do
			if child:IsA("GuiButton") then
				child:Destroy()
			end
		end
		for i, option in getOptions() do
			local selected = option == settings[key]
			local optionColor = getOptionColor and getOptionColor(option)
			local button = create("TextButton", {
				Name = option,
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundColor3 = if selected then COLORS.Accent else COLORS.Window,
				AutoButtonColor = not selected,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				Text = option,
				TextColor3 = if selected then Color3.new(1, 1, 1) else optionColor or COLORS.Text,
				Parent = list,
			}, { corner(UDim.new(0, 4)) })
			button.MouseButton1Click:Connect(function()
				settings[key] = option
				close()
				if onChange then
					onChange(option)
				end
			end)
		end
		list.Visible = true
		render()
	end

	headerButton.MouseButton1Click:Connect(function()
		if list.Visible then
			close()
		else
			open()
		end
	end)
	render()
	table.insert(controlRenderers, close)
end

