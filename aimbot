--// Tracking: cache mọi Model có Humanoid trong workspace thay vì quét lại mỗi frame

-- Mọi kết nối ngoài UI đều đi qua connect() để phím X gỡ được hết
local connections = {}

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local trackedModels = {} -- [Model] = Humanoid

local function trackHumanoid(inst)
	if inst:IsA("Humanoid") and inst.Parent and inst.Parent:IsA("Model") then
		trackedModels[inst.Parent] = inst
	end
end

for _, inst in workspace:GetDescendants() do
	trackHumanoid(inst)
end
connect(workspace.DescendantAdded, trackHumanoid)
connect(workspace.DescendantRemoving, function(inst)
	if inst:IsA("Humanoid") and inst.Parent and trackedModels[inst.Parent] == inst then
		trackedModels[inst.Parent] = nil
	end
end)

--// Team

local function getModelTeam(model)
	local owner = Players:GetPlayerFromCharacter(model)
	if owner then
		return if owner.Team and not owner.Neutral then owner.Team.Name else nil
	end
	local attribute = model:GetAttribute("Team")
	return if type(attribute) == "string" and attribute ~= "" then attribute else nil
end

local TEAM_COLOR_WORDS = {
	red = Color3.fromRGB(255, 80, 80),
	blue = Color3.fromRGB(80, 140, 255),
	green = Color3.fromRGB(80, 220, 120),
	yellow = Color3.fromRGB(255, 220, 70),
	orange = Color3.fromRGB(255, 150, 60),
	purple = Color3.fromRGB(170, 100, 255),
	pink = Color3.fromRGB(255, 120, 200),
	white = Color3.fromRGB(240, 240, 240),
	black = Color3.fromRGB(110, 110, 110),
}

local function getTeamColor(teamName)
	local team = Teams:FindFirstChild(teamName)
	if team and team:IsA("Team") then
		return team.TeamColor.Color
	end
	-- Team chỉ có trên attribute của NPC: đoán màu theo tên (Red, Blue...), không thì sinh màu cố định từ tên
	local lowerName = string.lower(teamName)
	for word, color in TEAM_COLOR_WORDS do
		if string.find(lowerName, word, 1, true) then
			return color
		end
	end
	local hash = 0
	for i = 1, #teamName do
		hash = (hash * 31 + string.byte(teamName, i)) % 360
	end
	return Color3.fromHSV(hash / 360, 0.6, 1)
end

-- "All", "Enemies" + mọi team đang có (Teams service và attribute Team của NPC)
local function getTeamOptions()
	local names, seen = {}, {}
	local function add(name)
		if name and not seen[name] then
			seen[name] = true
			table.insert(names, name)
		end
	end
	for _, team in Teams:GetTeams() do
		add(team.Name)
	end
	for model in trackedModels do
		add(getModelTeam(model))
	end
	table.sort(names)
	table.insert(names, 1, "All")
	table.insert(names, 2, "Enemies")
	return names
end

local function passesTeamFilter(model)
	local filter = settings.TeamFilter
	if filter == "All" then
		return true
	end
	local team = getModelTeam(model)
	if filter == "Enemies" then
		local myTeam = if player.Team and not player.Neutral then player.Team.Name else nil
		return myTeam == nil or team ~= myTeam
	end
	return team == filter
end

--// UI helpers

local function create(className, props, children)
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	local parent = props.Parent
	props.Parent = nil
	for key, value in props do
		inst[key] = value
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = radius or UDim.new(0, 6) })
end

local function label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextSize = props.TextSize or 13
	props.TextColor3 = props.TextColor3 or COLORS.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props)
end

local function listLayout(padding)
	return create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, padding or 0) })
end

