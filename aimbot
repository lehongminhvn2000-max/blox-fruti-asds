local function makeToggle(parent, order, text, key)
	local row = create("TextButton", {
		Name = key,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = COLORS.Row,
		AutoButtonColor = false,
		Text = "",
		Parent = parent,
	}, { corner() })
	label({ Text = text, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -60, 1, 0), Parent = row })

	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = COLORS.Off,
		Parent = row,
	}, { corner(UDim.new(1, 0)) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	}, { corner(UDim.new(1, 0)) })

	local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
	local function render()
		local on = settings[key]
		TweenService:Create(track, tweenInfo, { BackgroundColor3 = if on then COLORS.Accent else COLORS.Off }):Play()
		TweenService:Create(knob, tweenInfo, {
			Position = if on then UDim2.new(1, -16, 0.5, 0) else UDim2.new(0, 2, 0.5, 0),
		}):Play()
	end

	row.MouseButton1Click:Connect(function()
		settings[key] = not settings[key]
		render()
	end)
	render()
	toggles[key] = render
	table.insert(controlRenderers, render)
end

