local function updateEsp(originPos)
	for model, tag in espTags do
		if not trackedModels[model] then
			tag.billboard:Destroy()
			espTags[model] = nil
		end
	end
	for model, humanoid in trackedModels do
		local adornee = model:FindFirstChild("Head") or model.PrimaryPart
		local show = settings.ESP
			and adornee ~= nil
			and adornee:IsA("BasePart")
			and isAlive(model, humanoid)
			and (adornee.Position - originPos).Magnitude <= settings.MaxDistance
		if not show then
			if espTags[model] then
				espTags[model].billboard.Enabled = false
			end
			continue
		end
		local tag = getEspTag(model)
		local team = getModelTeam(model)
		local health = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
		tag.billboard.Adornee = adornee
		tag.billboard.Enabled = true
		tag.nameLabel.Text = string.format("%s  [%d]", model.Name, math.floor((adornee.Position - originPos).Magnitude))
		tag.nameLabel.TextColor3 = if team then getTeamColor(team) else COLORS.Text
		tag.healthFill.Size = UDim2.fromScale(health, 1)
		tag.healthFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.HealthHigh, health)
	end
end

--// ESP box + tracer + snap line (vẽ 2D trên overlay)

local overlayTags = {} -- [Model] = { box, stroke, tracer }

local BOX_CORNERS = {}
for _, x in { -1, 1 } do
	for _, y in { -1, 1 } do
		for _, z in { -1, 1 } do
			table.insert(BOX_CORNERS, Vector3.new(x, y, z) / 2)
		end
	end
end

-- Khung 2D bao quanh model: chiếu 8 góc bounding box lên màn hình; nil nếu có góc nằm sau camera
local function getScreenBox(camera, model)
	local cframe, size = model:GetBoundingBox()
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, cornerOffset in BOX_CORNERS do
		local point = camera:WorldToViewportPoint(cframe:PointToWorldSpace(cornerOffset * size))
		if point.Z <= 0 then
			return nil
		end
		minX, minY = math.min(minX, point.X), math.min(minY, point.Y)
		maxX, maxY = math.max(maxX, point.X), math.max(maxY, point.Y)
	end
	return Vector2.new(minX, minY), Vector2.new(maxX, maxY)
end

local function getOverlayTag(model)
	local tag = overlayTags[model]
	if not tag then
		local box = create("Frame", { BackgroundTransparency = 1, Visible = false, Parent = overlay })
		tag = {
			box = box,
			stroke = create("UIStroke", { Thickness = 1.5, Parent = box }),
			tracer = makeLine(overlay),
		}
		overlayTags[model] = tag
	end
	return tag
end

local function updateOverlay(camera, originPos, fovCenter, targetModel, targetPart, stateColor)
	for model, tag in overlayTags do
		if not trackedModels[model] then
			tag.box:Destroy()
			tag.tracer:Destroy()
			overlayTags[model] = nil
		end
	end

	local viewport = camera.ViewportSize
	local tracerOrigin = Vector2.new(viewport.X / 2, viewport.Y)
	local wantOverlay = settings.ESPBoxes or settings.Tracers
	for model, humanoid in trackedModels do
		local anchor = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Head")
		local topLeft, bottomRight = nil, nil
		if
			wantOverlay
			and anchor
			and isAlive(model, humanoid)
			and (anchor.Position - originPos).Magnitude <= settings.MaxDistance
		then
			topLeft, bottomRight = getScreenBox(camera, model)
		end
		local tag = overlayTags[model]
		if not topLeft then
			if tag then
				tag.box.Visible = false
				tag.tracer.Visible = false
			end
			continue
		end

		tag = getOverlayTag(model)
		local team = getModelTeam(model)
		local color = if model == targetModel then stateColor elseif team then getTeamColor(team) else COLORS.Text
		tag.box.Visible = settings.ESPBoxes
		tag.box.Position = UDim2.fromOffset(topLeft.X, topLeft.Y)
		tag.box.Size = UDim2.fromOffset(bottomRight.X - topLeft.X, bottomRight.Y - topLeft.Y)
		tag.stroke.Color = color
		if settings.Tracers then
			placeLine(tag.tracer, tracerOrigin, Vector2.new((topLeft.X + bottomRight.X) / 2, bottomRight.Y))
			tag.tracer.BackgroundColor3 = color
		else
			tag.tracer.Visible = false
		end
	end

	-- Snap line: từ tâm FOV tới part đang ngắm
	local snapPoint = nil
	if settings.SnapLine and targetPart then
		local point, onScreen = camera:WorldToViewportPoint(targetPart.Position)
		snapPoint = if onScreen then Vector2.new(point.X, point.Y) else nil
	end
	if snapPoint then
		placeLine(snapLine, fovCenter, snapPoint)
		snapLine.BackgroundColor3 = stateColor
	else
		snapLine.Visible = false
	end
end

local function updateTargetInfo(targetModel, targetPart, originPos)
	local humanoid = targetModel and trackedModels[targetModel]
	if not (settings.TargetInfo and humanoid and targetPart) then
		infoCard.Visible = false
		return
	end
	local team = getModelTeam(targetModel)
	local health = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
	infoCard.Visible = true
	infoName.Text = targetModel.Name
	infoName.TextColor3 = if team then getTeamColor(team) else COLORS.Text
	infoDistance.Text = string.format("%d studs", math.floor((targetPart.Position - originPos).Magnitude))
	infoFill.Size = UDim2.fromScale(health, 1)
	infoFill.BackgroundColor3 = COLORS.HealthLow:Lerp(COLORS.HealthHigh, health)
	infoDetail.Text = string.format(
		"%d / %d HP  ·  %s%s",
		math.ceil(humanoid.Health),
		math.floor(humanoid.MaxHealth),
		targetPart.Name,
		if team then "  ·  " .. team else ""
	)
end

--// Auto shoot: bóp cò Tool đang cầm (vd. súng Gun) khi tâm màn hình nằm trên mục tiêu đang khóa

local crosshairParams = RaycastParams.new()
crosshairParams.FilterType = Enum.RaycastFilterType.Exclude
crosshairParams.IgnoreWater = true

local function isCrosshairOn(camera, model)
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local ignore = { camera }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	crosshairParams.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(ray.Origin, ray.Direction * (settings.MaxDistance + 50), crosshairParams)
	return result ~= nil and result.Instance:IsDescendantOf(model)
end

local function getEquippedTool()
	local character = player.Character
	return character and character:FindFirstChildOfClass("Tool")
end

local autoFiringTool = nil
local lastAutoActivate = 0

-- tool = Tool cần giữ cò, nil = thả cò. Tool:Activate/Deactivate làm GunClient nhận Activated/Deactivated như bấm chuột
local function setAutoFire(tool)
	if autoFiringTool ~= tool then
		if autoFiringTool then
			pcall(autoFiringTool.Deactivate, autoFiringTool)
		end
		autoFiringTool = tool
		if tool then
			pcall(tool.Activate, tool)
			lastAutoActivate = os.clock()
		end
	elseif tool and tool:GetAttribute("Automatic") == false then
		-- Súng bán tự động: bóp cò lại theo FireRate
		if os.clock() - lastAutoActivate >= (tool:GetAttribute("FireRate") or 0.2) then
			pcall(tool.Deactivate, tool)
			pcall(tool.Activate, tool)
			lastAutoActivate = os.clock()
		end
	end
end

--// Main loop: chạy ngay sau camera mặc định để ghi đè hướng nhìn

local lockedModel = nil

RunService:BindToRenderStep("AimLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if mouseFree then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local mousePos = UserInputService:GetMouseLocation()
	local fovCenter = if settings.FOVOrigin == "Center" then camera.ViewportSize / 2 else mousePos
	local root = getCharacterRoot()
	local originPos = if root then root.Position else camera.CFrame.Position

	local aimInput = AIM_KEYS[settings.AimKey]
	-- Chỉ aim bằng chuột trái mới bị chặn khi đang bấm/kéo menu
	local uiBusy = aimInput == Enum.UserInputType.MouseButton1
		and (activeSlider ~= nil or dragStart ~= nil or isPointerOverMenu(mousePos))
	local holding = settings.Enabled
		and (aimInput == nil or (not uiBusy and UserInputService:IsMouseButtonPressed(aimInput)))

	-- Đang aim thì giữ mục tiêu cũ tới khi nó chết / bị che / ra khỏi màn hình, tránh nhảy mục tiêu
	local targetModel, targetPart = nil, nil
	if holding and lockedModel and settings.StickyLock then
		targetPart = keepLock(camera, lockedModel, fovCenter, originPos)
		targetModel = if targetPart then lockedModel else nil
	end
	if not targetPart and settings.Enabled then
		targetModel, targetPart = findTarget(camera, fovCenter, originPos)
	end
	local aiming = holding and targetPart ~= nil
	lockedModel = if aiming then targetModel else nil

	if aiming then
		local aimPos = targetPart.Position + targetPart.AssemblyLinearVelocity * settings.Prediction
		local alpha = if settings.Smoothness <= 0 then 1 else 1 - math.exp(-dt * 30 / settings.Smoothness)
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, aimPos), alpha)
	end

	local stateColor = if aiming then COLORS.Locked elseif targetPart then COLORS.Tracking else COLORS.Accent
	fovCircle.Visible = settings.Enabled and settings.ShowFOV
	fovCircle.Position = UDim2.fromOffset(fovCenter.X, fovCenter.Y)
	cursorDot.Visible = mouseFree
	cursorDot.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
	fovCircle.Size = UDim2.fromOffset(settings.FOV * 2, settings.FOV * 2)
	fovStroke.Color = stateColor
	statusDot.BackgroundColor3 = if settings.Enabled then stateColor else COLORS.Off

	local highlightModel = if targetModel and settings.Highlight then targetModel else nil
	if highlight.Adornee ~= highlightModel then
		highlight.Adornee = highlightModel
	end
	highlight.Enabled = highlightModel ~= nil
	highlight.FillColor = stateColor

	if targetModel then
		local team = getModelTeam(targetModel)
		statusLabel.Text = string.format(
			"Target: %s (%s)  ·  %d studs%s",
			targetModel.Name,
			targetPart.Name,
			math.floor((targetPart.Position - originPos).Magnitude),
			if team then "  ·  " .. team else ""
		)
	else
		statusLabel.Text = if settings.Enabled then "Target: none" else "Aim lock: OFF"
	end

	updateEsp(originPos)
	updateOverlay(camera, originPos, fovCenter, targetModel, targetPart, stateColor)
	updateTargetInfo(targetModel, targetPart, originPos)
	setAutoFire(
		if settings.AutoShoot and aiming and isCrosshairOn(camera, targetModel) then getEquippedTool() else nil
	)
end)

--// X (hoặc nút X trên menu): tắt hẳn script, gỡ mọi kết nối và xóa toàn bộ UI

local unloaded = false

unload = function()
	if unloaded then
		return
	end
	unloaded = true
	setAutoFire(nil)
	RunService:UnbindFromRenderStep("AimLock")
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, tag in espTags do
		tag.billboard:Destroy()
	end
	table.clear(espTags)
	if mouseFree then
		setMouseFree(false)
	end
	gui:Destroy()
end

closeButton.MouseButton1Click:Connect(unload)
