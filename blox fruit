local function EquipWeaponByType()
	local Char = Plr.Character
	if not Char then return nil end
	local Backpack = Plr:FindFirstChild("Backpack")
	if not Backpack then return nil end

	local toolTypeMap = { [1] = "Melee", [2] = "Blox Fruit", [3] = "Sword", [4] = "Gun" }
	local targetToolTip = toolTypeMap[_G.WeaponType]

	for _, t in pairs(Backpack:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == targetToolTip then
			Char.Humanoid:EquipTool(t)
			return t
		end
	end
	local anyTool = Char:FindFirstChildOfClass("Tool") or Backpack:FindFirstChildOfClass("Tool")
	if anyTool then Char.Humanoid:EquipTool(anyTool) end
	return anyTool
end

local function ToCFrame(cf)
	if not cf or not Plr.Character then return end
	local HRP = Plr.Character:FindFirstChild("HumanoidRootPart")
	if not HRP then return end

	local targetPos = cf.Position
	local Dist = (cf.Position - HRP.Position).Magnitude
	if Dist <= 10 then
		if CurrentTween then CurrentTween:Cancel() end
		HRP.CFrame = cf
		return
	end

	local Time = Dist / _G.FlySpeed
	if CurrentTween then CurrentTween:Cancel() end
	CurrentTween = TweenService:Create(HRP, TweenInfo.new(Time, Enum.EasingStyle.Linear), {CFrame = cf})
	CurrentTween:Play()
end

local function FindBestTarget(targetMobName)
	local bestTarget = nil
	local shortestDist = DETECT_RANGE
	local Enemies = workspace:FindFirstChild("Enemies")
	local HRP = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")

	if Enemies and HRP and targetMobName then
		for _, mob in pairs(Enemies:GetChildren()) do
			if mob and mob.Parent and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") then
				local mobHum = mob.Humanoid
				local mobHRP = mob.HumanoidRootPart
				if mobHum and mobHum.Health > 0 and mobHRP and mobHRP.Parent then
					if string.find(string.lower(mob.Name), string.lower(targetMobName)) then
						local dist = (mobHRP.Position - HRP.Position).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							bestTarget = mob
						end
					end
				end
			end
		end
	end
	return bestTarget
end

