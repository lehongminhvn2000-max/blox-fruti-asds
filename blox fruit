Close.MouseButton1Click:Connect(function()
	_G.Farm = false
	_G.AutoLevel = false
	_G.AutoBoss = false
	_G.AutoChest = false
	_G.AutoTPPlayer = false
	_G.AutoClick = false
	_G.AutoSkill = false
	_G.Chay = false
	Gui:Destroy()
end)

RunService.Heartbeat:Connect(function()
	if _G.Chay and _G.AutoClick then
		if _G.Farm and QMon then
			FastAttackAndBring(QMon, false)
		elseif _G.AutoLevel then
			local _, curMobName, _, _ = GetQuestByLevel()
			if curMobName then
				FastAttackAndBring(curMobName, false)
			end
		elseif _G.AutoBoss and SelectedBossName then
			FastAttackAndBring(SelectedBossName, true)
		end
	end
end)

task.spawn(function()
	while _G.Chay do
		task.wait(2)
		pcall(function()
			if _G.AutoHaki and Plr.Character and not Plr.Character:FindFirstChild("HasBuso") then
				local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
				local CommF = Remotes and Remotes:FindFirstChild("CommF_")
				if CommF then CommF:InvokeServer("HasBuso") end
				-- Them remote TimeSyncEvent de bat Haki
				local Clock = Remotes and Remotes:FindFirstChild("Clock")
				local TimeSync = Clock and Clock:FindFirstChild("TimeSyncEvent")
				if TimeSync then
					TimeSync:FireServer(os.time())
				end
			end
		end)
	end
end)

task.spawn(function()
	while _G.Chay do
		task.wait(3.5)
		if (_G.Farm or _G.AutoLevel or _G.AutoBoss) and _G.AutoSkill then ExecuteSkills() end
	end
end)

