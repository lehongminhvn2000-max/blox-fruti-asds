local function GetQuestByLevel()
	local myLevel = 1500
	pcall(function()
		if Plr.Data and Plr.Data:FindFirstChild("Level") then
			myLevel = Plr.Data.Level.Value
		elseif Plr:FindFirstChild("Data") and Plr.Data:FindFirstChild("Level") then
			myLevel = Plr.Data.Level.Value
		end
	end)

	for _, q in ipairs(LevelQuests) do
		if myLevel >= q.min and myLevel <= q.max then
			return q.name, q.mob, q.id, myLevel
		end
	end
	return "PiratePortQuest", "Pirate Millionaire", 1, myLevel
end

