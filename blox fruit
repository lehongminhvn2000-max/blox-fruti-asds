local function FastAttackAndBring(targetMobName, isBossMode)
	local Char = Plr.Character
	if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end
	local HRP = Char.HumanoidRootPart
	local Weapon = EquipWeaponByType()

	local Enemies = workspace:FindFirstChild("Enemies")
	if Enemies then
		for _, mob in pairs(Enemies:GetChildren()) do
			if mob and mob.Parent and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") then
				local mobHum = mob.Humanoid
				local mobHRP = mob.HumanoidRootPart
				if not mobHum or mobHum.Health <= 0 or not mobHRP or not mobHRP.Parent then continue end

				local matchCondition = false
				if isBossMode and SelectedBossName and string.find(string.lower(mob.Name), string.lower(SelectedBossName)) then
					matchCondition = true
				elseif not isBossMode and targetMobName and string.find(string.lower(mob.Name), string.lower(targetMobName)) then
					matchCondition = true
				end

				if matchCondition then
					local dist = (mobHRP.Position - HRP.Position).Magnitude

					if dist <= HITBOX_RANGE then
						mobHRP.CFrame = HRP.CFrame * CFrame.new(0, -(_G.AttackHeight) + 2, -3)
						mobHRP.Size = Vector3.new(60, 60, 60)
						mobHRP.Transparency = 1
						mobHRP.CanCollide = false
						mobHum.PlatformStand = true
					end
				end
			end
		end
	end

	pcall(function()
		local NetMod = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
		if NetMod and NetMod:FindFirstChild("RE/PlayAttackStartEffect") and Weapon then
			NetMod["RE/PlayAttackStartEffect"]:FireServer(Weapon, 3)
		end
		if Weapon then Weapon:Activate() end

		local Camera = workspace.CurrentCamera
		if Camera then
			local Viewport = Camera.ViewportSize
			VirtualInputManager:SendMouseButtonEvent(Viewport.X / 2, Viewport.Y / 2, 0, true, game, 1)
			VirtualInputManager:SendMouseButtonEvent(Viewport.X / 2, Viewport.Y / 2, 0, false, game, 1)
		end
	end)
end

