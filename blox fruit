local PlayerButtons = {}
local function RefreshPlayerList()
	for _, btn in pairs(PlayerButtons) do
		if btn then btn:Destroy() end
	end
	PlayerButtons = {}

	local pCount = 0
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= Plr then
			pCount = pCount + 1
			local pBtn = Instance.new("TextButton", PlayerListSF)
			pBtn.Size = UDim2.new(1, 0, 0, 24)
			pBtn.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
			pBtn.Text = "  👤 " .. p.Name
			pBtn.TextColor3 = Color3.fromRGB(180, 190, 205)
			pBtn.Font = Enum.Font.Gotham
			pBtn.TextSize = 10
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 5)

			pBtn.MouseButton1Click:Connect(function()
				SelectedTargetPlayer = p
				for _, btn in pairs(PlayerButtons) do
					btn.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
					btn.TextColor3 = Color3.fromRGB(180, 190, 205)
				end
				pBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 230)
				pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			end)
			table.insert(PlayerButtons, pBtn)
		end
	end
	PlayerListSF.CanvasSize = UDim2.new(0, 0, 0, pCount * 28)
end

