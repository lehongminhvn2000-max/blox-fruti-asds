-- Auto Respawn
local respawnDelay = 0
task.spawn(function()
	while _G.Chay do
		task.wait(1)
		if _G.AutoRespawn then
			pcall(function()
				local Char = Plr.Character
				if Char then
					local humanoid = Char:FindFirstChildOfClass("Humanoid")
					if humanoid and humanoid.Health <= 0 then
						task.wait(1.5)
						Plr:LoadCharacter()
					end
				end
			end)
		end
	end
end)

