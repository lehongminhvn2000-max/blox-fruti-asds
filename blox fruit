ToggleFog.MouseButton1Click:Connect(function()
	if not fogToggled then
		savedFogStart = Lighting.FogStart
		savedFogEnd = Lighting.FogEnd

		local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
		if atmosphere then
			savedAtmosphere = atmosphere
			savedAtmosphereParent = atmosphere.Parent
			atmosphere.Parent = nil
		end

		Lighting.FogStart = 999999
		Lighting.FogEnd = 999999

		ToggleFog.Text = "XÓA SƯƠNG MÙ: BẬT"
		ToggleFog.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
		fogToggled = true
	else
		Lighting.FogStart = savedFogStart
		Lighting.FogEnd = savedFogEnd

		if savedAtmosphere then
			savedAtmosphere.Parent = savedAtmosphereParent
			savedAtmosphere = nil
		end

		ToggleFog.Text = "XÓA SƯƠNG MÙ: TẮT"
		ToggleFog.BackgroundColor3 = Color3.fromRGB(180, 40, 60)
		fogToggled = false
	end
end)

