-- Spectate Player (camera theo doi nguoi choi)
RunService.RenderStepped:Connect(function()
	if _G.Spectating and SelectedTargetPlayer then
		pcall(function()
			local Camera = workspace.CurrentCamera
			if Camera and SelectedTargetPlayer.Character and SelectedTargetPlayer.Character:FindFirstChildOfClass("Humanoid") then
				Camera.CameraType = Enum.CameraType.Custom
				Camera.CameraSubject = SelectedTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
			end
		end)
	end
end)

task.spawn(function()
	while _G.Chay do
		task.wait(0.1)
		if _G.Farm and QMon then
			pcall(function()
				local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
				local CommF = Remotes and Remotes:FindFirstChild("CommF_")
				local QuestUI = Plr.PlayerGui:FindFirstChild("Main") and Plr.PlayerGui.Main:FindFirstChild("Quest")
				local HasQ = QuestUI and QuestUI.Visible

				if not HasQ then
					Status.Text = "Đang nhận nhiệm vụ: " .. QMon
					if CommF then CommF:InvokeServer("StartQuest", QName, QID) end
				else
					local TargetMob = FindBestTarget(QMon)
					local destinationCF = nil

					if TargetMob and TargetMob.Parent and TargetMob:FindFirstChild("HumanoidRootPart") then
						local mobHRP = TargetMob.HumanoidRootPart
						if mobHRP and mobHRP.Parent then
							destinationCF = mobHRP.CFrame * CFrame.new(0, _G.AttackHeight, 0)
						end
					elseif BackupCF then
						destinationCF = BackupCF * CFrame.new(0, _G.AttackHeight, 0)
					end

					if destinationCF then
						local hrp = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
						if hrp and (destinationCF.Position - hrp.Position).Magnitude > 8 then
							Status.Text = "Đang bay đến bãi (Speed: " .. _G.FlySpeed .. ")"
							ToCFrame(destinationCF)
						else
							if CurrentTween then CurrentTween:Cancel() end
							if hrp then hrp.CFrame = destinationCF end
							Status.Text = "Đang đánh quái: " .. QMon
						end
					end
				end
			end)
		end
	end
end)

