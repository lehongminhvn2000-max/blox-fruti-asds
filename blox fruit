	ToggleClick.Text = _G.AutoClick and "AUTO CLICK / FAST ATTACK: BẬT" or "AUTO CLICK / FAST ATTACK: TẮT"
	ToggleClick.BackgroundColor3 = _G.AutoClick and Color3.fromRGB(40, 180, 100) or Color3.fromRGB(180, 40, 60)
end)

ToggleSkill.MouseButton1Click:Connect(function()
	_G.AutoSkill = not _G.AutoSkill
	ToggleSkill.Text = _G.AutoSkill and "AUTO SKILL: BẬT" or "AUTO SKILL: TẮT"
	ToggleSkill.BackgroundColor3 = _G.AutoSkill and Color3.fromRGB(40, 180, 100) or Color3.fromRGB(35, 40, 55)
